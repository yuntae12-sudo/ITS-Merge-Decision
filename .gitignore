# Dataset
data/*
!data/.gitkeep

# data/manifests/ holds both the canonical final MERGE Dataset
# artifacts (tracked -- they ARE the frozen research decision, not
# regeneratable from git alone once the construction chain's raw WOMD
# inputs are gone) and legacy/regeneratable working files (gitignored).
!data/manifests/
data/manifests/*
!data/manifests/.gitkeep
!data/manifests/merge_maneuvers.csv
!data/manifests/merge_decision_manifest.csv
!data/manifests/merge_split.csv
!data/manifests/evidence_training.jsonl
!data/manifests/evidence_validation.jsonl
!data/manifests/freeze.json
!data/manifests/phase2_dataset_split.csv

# Generated runtime artifacts (checkpoints/visualizations/metrics) --
# regenerated by scripts/train_ppo.py, scripts/smoke_ppo.py, and
# scripts/visualize_ppo.py. Never a source of truth.
outputs/*
!outputs/.gitkeep
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/visualizations/*
!outputs/visualizations/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/

# Virtual / Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# W&B local run artifacts -- offline-run directories are local run
# logs/binaries, not source.
wandb/
